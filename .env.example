# Shared release metadata
ENVIRONMENT=local
PLATFORM_VERSION=1.1.0
SERVICE_VERSION=1.1.0

# Portal demo authentication (local/interview only)
DEMO_VIEWER_USERNAME=
DEMO_VIEWER_PASSWORD=
DEMO_ANALYST_USERNAME=
DEMO_ANALYST_PASSWORD=
SESSION_SECRET=

# Internal Portal/BFF -> application-service identity
BFF_INTERNAL_TOKEN=

# Workload identities for application services -> ML service
ESTIMATOR_ML_TOKEN=
MARKET_ML_TOKEN=

# Local service addresses
ML_SERVICE_URL=http://localhost:8000
ESTIMATOR_SERVICE_URL=http://localhost:8001
MARKET_SERVICE_URL=http://localhost:8080

# Protection / resilience
MAX_BATCH_SIZE=100
ML_CONNECT_TIMEOUT_SECONDS=2
ML_READ_TIMEOUT_SECONDS=5
ML_CONNECT_TIMEOUT_MS=2000
ML_READ_TIMEOUT_MS=5000
